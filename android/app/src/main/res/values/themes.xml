<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#F2EFEA</color>
    <color name="bg">#0E0F12</color>
    <color name="orange">#FF8A1F</color>
    <color name="ic_launcher_background">#0E0F12</color>

    <style name="Theme.Jarvis" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/orange</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>

    <style name="Theme.Jarvis.Invisible" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowNoDisplay">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
